{
  "name": "sql-db-visualizer",
  "displayName": "SQL Database Visualizer",
  "description": "Visualize SQLite database schemas, ER diagrams, and preview table data",
  "version": "0.1.0",
  "publisher": "sdd-poc",
  "license": "MIT",
  "engines": {
    "vscode": "^1.85.0"
  },
  "categories": [
    "Visualization"
  ],
  "activationEvents": [],
  "main": "./dist/extension.js",
  "contributes": {
    "customEditors": [
      {
        "viewType": "sqlDbVisualizer.schemaView",
        "displayName": "SQL Database Visualizer",
        "selector": [
          { "filenamePattern": "*.db" },
          { "filenamePattern": "*.sqlite" },
          { "filenamePattern": "*.sqlite3" }
        ],
        "priority": "default"
      }
    ]
  },
  "scripts": {
    "build": "node esbuild.mjs",
    "watch": "node esbuild.mjs --watch",
    "lint": "eslint src/",
    "package": "vsce package",
    "dev": "code --extensionDevelopmentPath=${workspaceFolder}"
  },
  "dependencies": {
    "sql.js": "^1.11.0",
    "@xyflow/react": "^12.4.0",
    "elkjs": "^0.9.3",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@types/vscode": "^1.85.0",
    "@types/react": "^18.3.0",
    "@types/react-dom": "^18.3.0",
    "typescript": "^5.7.0",
    "esbuild": "^0.24.0",
    "eslint": "^9.0.0",
    "@vscode/vsce": "^3.0.0"
  }
}
